API_URL=http://127.0.0.1:8000
# PostgreSQL is used by Docker Compose. For a local API without Docker, omit
# DATABASE_URL to use the supported SQLite demo fallback.
# DATABASE_URL=postgresql+psycopg://estate:estate_demo@localhost:5432/estate
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
